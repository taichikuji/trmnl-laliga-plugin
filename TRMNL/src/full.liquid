<div class="layout layout--col layout--center gap--large text--center">
  <span class="title title--large lg:title--xxlarge">{{ t_title }}</span>

  {% render 'status_result',
    state: state,
    answer: t_answer,
    answer_class: answer_class,
    description: t_desc,
    blocked_text: blocked_text,
    svg_logo: svg_logo,
    value_class: 'value--mega lg:value--giga',
    description_class: 'description--large lg:description--xlarge'
  %}
</div>

{% render 'laliga_title_bar', svg_logo: svg_logo, title: 'hayahora.futbol', update_time: updated_text %}
