<div class="layout layout--col layout--center gap text--center px--2 laliga-compact">
  <span class="title title--large lg:title--xlarge">{{ t_title }}</span>

  {% render 'status_result',
    state: state,
    answer: t_answer,
    answer_class: answer_class,
    blocked_text: blocked_text,
    svg_logo: svg_logo,
    value_class: 'value--xxlarge lg:value--xxxlarge',
    description_class: 'description--small'
  %}
</div>

{% render 'laliga_title_bar', svg_logo: svg_logo, title: 'hayahora.futbol', update_time: updated_text %}